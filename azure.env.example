# Azure OpenAI settings for the LLM field filler.
# Copy to azure.env and fill in. azure.env is git-ignored; never commit real keys.

# Resource endpoint, e.g. https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Key 1 or Key 2 from the resource's "Keys and Endpoint" page
AZURE_OPENAI_API_KEY=

# API version. Structured outputs (JSON schema responses) need 2024-08-01-preview or later.
AZURE_OPENAI_API_VERSION=2024-10-21

# The *deployment name* you gave the model in Azure AI Foundry (not necessarily the model name).
AZURE_OPENAI_DEPLOYMENT=

# Optional: the underlying model, for logs / token estimates (e.g. what the deployment runs).
AZURE_OPENAI_MODEL=

# Model prices per 1M tokens, used to estimate costs before filling.
# (Training and hosting prices only apply to fine-tuned models; not used.)
AZURE_OPENAI_PRICE_INPUT_PER_1M=
AZURE_OPENAI_PRICE_CACHED_INPUT_PER_1M=
AZURE_OPENAI_PRICE_OUTPUT_PER_1M=
AZURE_OPENAI_PRICE_CURRENCY=USD
